# WebSocket signaling server URL — used by the browser to connect.
# Dev:  ws://localhost:3001
# Prod: wss://your-domain.com/ws-signal  (must be HTTPS / WSS for WebRTC)
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# Optional: JSON array of RTCIceServer entries.
# Empty = Google public STUN only. For production add your coturn TURN server:
# NEXT_PUBLIC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":["turn:your-domain.com:3478?transport=udp","turn:your-domain.com:3478?transport=tcp"],"username":"hamsabhat","credential":"YOUR_TURN_PASSWORD"}]
NEXT_PUBLIC_ICE_SERVERS=

# Signaling server listen port (used by server/index.ts)
PORT=3001